# syntax=docker/dockerfile:1

ARG ALPINE_VERSION=3.23.3
ARG ALPINE_IMAGE_DIGEST=sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659

# Alpine publishes a LoongArch64 minirootfs but not a Docker Official Image
# manifest. Fetch and verify that official rootfs in a native build stage,
# then execute it as the linux/loong64 target through the pinned QEMU image.
FROM --platform=$BUILDPLATFORM alpine:${ALPINE_VERSION}@${ALPINE_IMAGE_DIGEST} AS rootfs

ARG ALPINE_MINIROOTFS_URL=https://dl-cdn.alpinelinux.org/alpine/v3.23/releases/loongarch64/alpine-minirootfs-3.23.3-loongarch64.tar.gz
ARG ALPINE_MINIROOTFS_SHA256=46550a8ffeede49128048a0f2deeec0a154484b0fb4c29cbcd499048d3be5271

RUN wget -O /tmp/alpine-minirootfs.tar.gz "$ALPINE_MINIROOTFS_URL" \
    && printf '%s  %s\n' "$ALPINE_MINIROOTFS_SHA256" /tmp/alpine-minirootfs.tar.gz \
        | sha256sum -c - \
    && mkdir /rootfs \
    && tar -xzf /tmp/alpine-minirootfs.tar.gz -C /rootfs

FROM scratch

COPY --from=rootfs /rootfs/ /

RUN apk add --no-cache \
        binutils \
        build-base \
        bzip2 \
        ca-certificates \
        curl \
        file \
        linux-headers \
        make \
        musl-dev \
        patch \
        perl

WORKDIR /workspace
